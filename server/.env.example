PORT=4000
DATABASE_URL="postgresql://user:password@your-neon-host/dbname?sslmode=require"

# The password the timetable office signs in with. Without it nobody can
# reach the admin side at all — the public timetable and class-adjustment
# pages still work.
ADMIN_PASSWORD="change-me"

# Signs the admin session cookie. Any long random string; changing it signs
# everyone out. Optional — one is derived from ADMIN_PASSWORD if unset.
SESSION_SECRET=""
