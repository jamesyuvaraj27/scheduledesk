// ScheduleDesk — Prisma schema
// Mirrors the data model in PLAN.md §5. DB starts empty — no seed data, ever.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Terms & timing ----------

model AcademicTerm {
  id        String   @id @default(cuid())
  year      Int
  semester  Int
  label     String // e.g. "2026-27 / Sem I"
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  timeConfig         TimeConfig?
  sectionSubjects    SectionSubject[]
  sectionAssignments SectionAssignment[]
  timetableEntries   TimetableEntry[]
  timetableVersions  TimetableVersion[]

  @@index([isActive])
}

// One row per term. Everything about daily timing is editable here —
// clock times for each period are computed by walking this config forward.
model TimeConfig {
  id                String   @id @default(cuid())
  termId            String   @unique
  term              AcademicTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  startTime         String   // "08:00"
  numPeriods        Int      @default(7)
  // Morning and afternoon periods can be different lengths — the split is
  // lunch. Periods up to and including lunchAfterPeriod use the morning
  // duration; everything after it uses the afternoon duration.
  morningPeriodDurationMin   Int @default(60)
  afternoonPeriodDurationMin Int @default(50)
  breakAfterPeriod  Int      @default(2)   // break falls after this period number
  breakDurationMin  Int      @default(15)
  lunchAfterPeriod  Int      @default(5)   // lunch falls after this period number
  lunchDurationMin  Int      @default(60)
  workingDays       String[] @default(["MON", "TUE", "WED", "THU", "FRI", "SAT"])
}

// ---------- Academic structure ----------

model Department {
  id   String @id @default(cuid())
  name String
  code String @unique // ASCE, CSE, ECE, EEE, MECH, CIVIL

  branches Branch[]
  faculty  Faculty[]
}

model Branch {
  id           String @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  name         String
  code         String // AIML, CAI, CSM, CSD, CSE, ECE, MECH, EEE, CIVIL...

  sections Section[]
  subjects Subject[]

  @@unique([departmentId, code])
}

// Every branch has at least one Section row, even if it has no real
// divisions (e.g. a single "CSE" section) — keeps every query uniform.
model Section {
  id         String @id @default(cuid())
  branchId   String
  branch     Branch @relation(fields: [branchId], references: [id])
  year       Int    // 1-4
  name       String // "A", "B", or branch code itself if undivided
  homeRoomId String?
  homeRoom   Room?  @relation(fields: [homeRoomId], references: [id])

  sectionSubjects    SectionSubject[]
  sectionAssignments SectionAssignment[]
  timetableEntries   TimetableEntry[]

  @@unique([branchId, year, name])
}

model Room {
  id       String  @id @default(cuid())
  name     String  @unique
  type     RoomType
  capacity Int?
  // Physical location. Rooms are named by block + floor in this college
  // (e.g. block A, first floor -> "AFF-1"), so both are stored separately
  // to allow filtering and bulk creation per block/floor.
  block    Block?
  floor    Floor?
  // Optional year the room is set aside for (1-4). Rooms with no year set
  // are available to every year — that's the default, so nothing has to be
  // filled in for existing rooms.
  year     Int?

  sectionsUsingAsHome Section[]
  timetableEntries    TimetableEntry[]

  @@index([block, floor])
}

enum RoomType {
  CLASSROOM
  LAB
  LIBRARY
  SEMINAR_HALL
}

enum Block {
  A
  L
  V
}

enum Floor {
  GF // ground floor
  FF // first floor
  SF // second floor
  TF // third floor
  LF // last floor
}

// ---------- Faculty & subjects ----------

model Faculty {
  id           String  @id @default(cuid())
  // Human-facing unique identifier (FAC001, FAC002 ...). Two people can share
  // a name; this is what tells them apart on screen. Internally every
  // relation still points at `id` — facultyNo is for display and for the
  // office to type, never a foreign key.
  facultyNo    String  @unique
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  isActive     Boolean @default(true)

  eligibleSubjects   FacultySubject[]
  sectionAssignments SectionAssignment[]
  timetableEntries   TimetableEntry[]
}

model Subject {
  id       String      @id @default(cuid())
  branchId String
  branch   Branch      @relation(fields: [branchId], references: [id])
  name     String
  code     String      // short code shown in grid cells, e.g. "BDA", "ESIA"
  type     SubjectType

  eligibleFaculty    FacultySubject[]
  sectionSubjects    SectionSubject[]
  sectionAssignments SectionAssignment[]
  timetableEntries   TimetableEntry[]

  @@unique([branchId, code])
}

enum SubjectType {
  THEORY
  LAB
}

// Eligibility: which faculty CAN teach which subject (many-to-many).
// Cascades on subject delete — removing a subject must not leave a faculty
// member marked eligible for something that no longer exists.
model FacultySubject {
  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([facultyId, subjectId])
}

// Curriculum config: required weekly hours per section per subject, per term
model SectionSubject {
  id              String  @id @default(cuid())
  termId          String
  term            AcademicTerm @relation(fields: [termId], references: [id])
  sectionId       String
  section         Section @relation(fields: [sectionId], references: [id])
  subjectId       String
  subject         Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  weeklyTheoryHrs Int     @default(0)
  weeklyLabHrs    Int     @default(0)

  @@unique([termId, sectionId, subjectId])
}

// Locked-in Section -> Subject -> Faculty mapping for the term
model SectionAssignment {
  id        String  @id @default(cuid())
  termId    String
  term      AcademicTerm @relation(fields: [termId], references: [id])
  sectionId String
  section   Section @relation(fields: [sectionId], references: [id])
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id])

  @@unique([termId, sectionId, subjectId])
}


// ---------- Timetable versions (Live / Working) ----------

// The timetable the college is actually following is LIVE. Preparing next
// week's changes happens on a WORKING copy, which is a completely separate
// set of TimetableEntry rows — editing one cannot touch the other, because
// they are different rows, not different flags on the same row.
//
// Master data (faculty, rooms, subjects, sections) is deliberately NOT
// versioned. There is one Faculty row per person no matter which timetable
// is being looked at.
enum VersionKind {
  LIVE
  WORKING
  ARCHIVED
}

model TimetableVersion {
  id          String      @id @default(cuid())
  termId      String
  term        AcademicTerm @relation(fields: [termId], references: [id], onDelete: Cascade)
  kind        VersionKind
  label       String
  note        String?
  createdAt   DateTime    @default(now())
  publishedAt DateTime?
  // Set on an ARCHIVED version: the working copy it was replaced by.
  replacedAt  DateTime?

  entries TimetableEntry[]

  // Partial unique indexes enforce "at most one LIVE and one WORKING per
  // term" — see the migration. Prisma can't express partial indexes, so they
  // live in raw SQL there.
  @@index([termId, kind])
}

// ---------- The actual timetable ----------

enum EntryType {
  THEORY
  LAB
  LIBRARY
  SEMINAR
  COUNSELING
  SPORTS
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

// The placed cell(s). periodSpan is chosen freely when placing — a lab is
// however many consecutive periods the user says it is, not a fixed 3.
// Faculty timetables are never stored — they're derived by querying this
// table WHERE facultyId = X across every section/year in the active term.
model TimetableEntry {
  id          String    @id @default(cuid())
  termId      String
  term        AcademicTerm @relation(fields: [termId], references: [id])
  // Which version of the timetable this cell belongs to. Every query that
  // reads or writes entries filters on this — that is the isolation.
  versionId   String
  version     TimetableVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  sectionId   String
  section     Section   @relation(fields: [sectionId], references: [id])
  dayOfWeek   DayOfWeek
  startPeriod Int
  periodSpan  Int       @default(1) // any 1..numPeriods; user-chosen for labs
  entryType   EntryType

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  facultyId String?
  faculty   Faculty? @relation(fields: [facultyId], references: [id])
  roomId    String?
  room      Room?    @relation(fields: [roomId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([versionId, sectionId, dayOfWeek])
  @@index([versionId, facultyId, dayOfWeek])
  @@index([versionId, roomId, dayOfWeek])
  @@index([termId, sectionId, dayOfWeek])
}
